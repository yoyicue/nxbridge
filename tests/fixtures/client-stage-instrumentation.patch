+package com.limelight.binding.input;
+
+import android.os.SystemClock;
+import android.util.Log;
+import android.view.MotionEvent;
+
+/** Diagnostic-only probe: no network I/O, temporary values live on the event thread. */
+public final class ClientStageTiming {
+    private static final ThreadLocal<Sample> ACTIVE = new ThreadLocal<>();
+    private static final class Sample {
+        int action; long eventMs, entryUptimeMs, entryNs, sendNs = -1;
+    }
+    public static void begin(MotionEvent event) {
+        Sample s = new Sample(); s.action = event.getActionMasked();
+        s.eventMs = event.getEventTime(); s.entryUptimeMs = SystemClock.uptimeMillis(); s.entryNs = System.nanoTime();
+        ACTIVE.set(s);
+    }
+    public static void mark(byte leftTrigger) {
+        Sample s = ACTIVE.get(); if (s == null || s.sendNs != -1) return;
+        boolean pressed = (leftTrigger & 255) >= 128;
+        if (pressed == (s.action == MotionEvent.ACTION_DOWN)) s.sendNs = System.nanoTime();
+    }
+    public static void end() {
+        Sample s = ACTIVE.get(); ACTIVE.remove(); if (s == null) return;
+        long endNs = System.nanoTime();
+        Log.i("NXBClientStage", "v1 action=" + s.action + " event_ms=" + s.eventMs + " entry_ms=" + s.entryUptimeMs +
+                " dispatch_ms=" + (s.entryUptimeMs - s.eventMs) + " to_call_ns=" + (s.sendNs < 0 ? -1 : s.sendNs - s.entryNs) +
+                " callback_ns=" + (endNs - s.entryNs));
+    }
+}
