+    private final class NxbPendingRelease implements Runnable {
+        private final InputDeviceContext context;
+        private final int keyCode;
+        private final KeyEvent event;
+        NxbPendingRelease(InputDeviceContext context, int keyCode, KeyEvent event) {
+            this.context = context; this.keyCode = keyCode; this.event = event;
+        }
+        @Override public void run() {
+            synchronized (ControllerHandler.this) {
