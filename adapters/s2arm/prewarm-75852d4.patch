+// Prepare the observed colour-copy format on the submit thread. The
+// preparation path uses only the format and stops before encoding a copy.
+static void nxb_copy_prepare(void) {
+    @autoreleasepool {
+        MTLTextureDescriptor *desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRG11B10Float width:1 height:1 mipmapped:NO];
+        desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        id<MTLTexture> texture = [g_dev newTextureWithDescriptor:desc];
+        if (!texture) {
+            MLOG("[nxb-copy-prepare] texture allocation failed; normal first use retained");
+            return;
+        }
+        NVNcopyRegion region = {0, 0, 0, 1, 1, 1};
+        uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        int ready = nxb_copy_t2t(texture, texture, 0, 0, 0, 0, &region, &region, 1, 0, true);
+        MLOG("[nxb-copy-prepare] format=RG11B10Float ready=%d elapsed_ms=%.3f (pipeline only; no GPU copy)",
+             ready, (clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start) / 1e6);
+    }
+}
