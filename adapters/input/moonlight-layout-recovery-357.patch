--- /dev/null
+++ b/app/src/main/java/com/limelight/binding/input/virtual_controller/LayoutRecoveryFiles.java
@@ -0,0 +1,47 @@
+package com.limelight.binding.input.virtual_controller;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+
+/** Bounded, non-destructive backup of the exact file the player saw as invalid. */
+public final class LayoutRecoveryFiles {
+    private static final long MAX_RECOVERY_BYTES = 8L * 1024 * 1024;
+    public static final class Changed extends IOException {
+        public Changed() { super("invalid layout changed since it was read"); }
+    }
+    private LayoutRecoveryFiles() { }
+
+    private static MessageDigest digest() throws IOException {
+        try { return MessageDigest.getInstance("SHA-256"); }
+        catch (NoSuchAlgorithmException e) { throw new IOException("SHA-256 unavailable", e); }
+    }
+    private static byte[] copy(File source, File backup) throws IOException {
+        MessageDigest hash = digest(); long total = 0;
+        try (FileInputStream in = new FileInputStream(source);
+             FileOutputStream out = backup == null ? null : new FileOutputStream(backup)) {
+            byte[] block = new byte[8192]; int n;
+            while ((n = in.read(block)) != -1) {
+                total += n; if (total > MAX_RECOVERY_BYTES) throw new IOException("invalid layout too large to recover");
+                hash.update(block, 0, n); if (out != null) out.write(block, 0, n);
+            }
+            if (out != null) out.getFD().sync();
+        }
+        return hash.digest();
+    }
+    public static byte[] fingerprint(File source) throws IOException { return copy(source, null); }
+    public static File backupIfUnchanged(File source, byte[] expected) throws IOException {
+        if (expected == null || expected.length != 32) throw new IOException("missing recovery fingerprint");
+        File backup = File.createTempFile(source.getName() + ".invalid-", ".backup", source.getParentFile());
+        try {
+            if (!MessageDigest.isEqual(expected, copy(source, backup))) throw new Changed();
+            return backup;
+        } catch (IOException | RuntimeException e) {
+            if (!backup.delete()) backup.deleteOnExit();
+            throw e;
+        }
+    }
+}
