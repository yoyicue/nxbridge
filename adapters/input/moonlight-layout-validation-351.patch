+package com.limelight.binding.input.virtual_controller;
+
+/** Geometry after projection to actual Android view pixels. */
+public final class LayoutGeometry {
+    private LayoutGeometry() { }
+
+    public static boolean overlaps(int ax, int ay, int aw, int ah, int bx, int by, int bw, int bh) {
+        return (long) ax < (long) bx + bw && (long) ax + aw > bx &&
+                (long) ay < (long) by + bh && (long) ay + ah > by;
+    }
+}
