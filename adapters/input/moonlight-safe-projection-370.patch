+package com.limelight.binding.input.virtual_controller;
+
+/** Versioned layout geometry, projected to the current visible safe area. */
+public final class LayoutProjection {
+    private LayoutProjection() { }
+    private static boolean invalid(double value) { return Double.isNaN(value) || Double.isInfinite(value); }
+
+    /** Schema 2: ordinary controls use safe-area centers and short-side sizes;
+     * floating-stick activation zones use a safe-area-relative rectangle. */
+    public static double[] encode(LayoutSafeArea safe, boolean zone, int x, int y, int w, int h) {
+        if (!safe.contains(x, y, w, h)) throw new IllegalArgumentException("outside safe area");
+        double sw = safe.right - (double)safe.left, sh = safe.bottom - (double)safe.top;
+        double shortSide = Math.min(sw, sh);
+        if (zone) return new double[]{(x-safe.left)/sw, (y-safe.top)/sh, w/sw, h/sh};
+        return new double[]{(x + w/2.0 - safe.left)/sw, (y + h/2.0 - safe.top)/sh, w/shortSide, h/shortSide};
+    }
+
+    /** Returns raw projected pixels; caller clamps and validates their final intersections. */
+    public static int[] project(int schema, LayoutSafeArea safe, int width, int height,
+                                boolean zone, double x, double y, double w, double h) {
+        if (width <= 0 || height <= 0 || invalid(x) || invalid(y) || invalid(w) || invalid(h) || x < 0 || y < 0 || x > 1 || y > 1 || w <= 0 || h <= 0)
+            throw new IllegalArgumentException("invalid layout coordinates");
+        double sw = safe.right - (double)safe.left, sh = safe.bottom - (double)safe.top;
+        double px, py, pw, ph;
+        if (schema == 1) {
+            if (x+w > 1.000001 || y+h > 1.000001) throw new IllegalArgumentException("legacy bounds");
+            px = x*width; py = y*height; pw = w*width; ph = h*height;
+        } else if (schema == 2 && zone) {
+            if (x+w > 1.000001 || y+h > 1.000001) throw new IllegalArgumentException("zone bounds");
+            px = safe.left + x*sw; py = safe.top + y*sh; pw = w*sw; ph = h*sh;
+        } else if (schema == 2) {
+            double side = Math.min(sw, sh);
+            pw = w*side; ph = h*side;
+            if (invalid(pw) || invalid(ph) || pw > sw + .000001 || ph > sh + .000001)
+                throw new IllegalArgumentException("control exceeds safe area");
+            px = safe.left + x*sw - pw/2.0; py = safe.top + y*sh - ph/2.0;
+        } else throw new IllegalArgumentException("unknown schema");
+        long l = Math.round(px), t = Math.round(py), rw = Math.round(pw), rh = Math.round(ph);
+        if (l < Integer.MIN_VALUE || l > Integer.MAX_VALUE || t < Integer.MIN_VALUE || t > Integer.MAX_VALUE ||
+            rw <= 0 || rh <= 0 || rw > Integer.MAX_VALUE || rh > Integer.MAX_VALUE)
+            throw new IllegalArgumentException("invalid projected bounds");
+        return new int[]{(int)l, (int)t, (int)rw, (int)rh};
+    }
+}
