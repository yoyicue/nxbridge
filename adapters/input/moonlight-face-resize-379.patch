+package com.limelight.binding.input.virtual_controller;
+
+/** Uniformly scale a group around its bounding-box center or reject the candidate. */
+public final class FaceGroupResize {
+    private FaceGroupResize() { }
+
+    public static int[][] plan(int[][] group, int[][] obstacles, int left, int top, int right, int bottom, int minSize, double scale) {
+        if (group == null || group.length != 4 || obstacles == null || right <= left || bottom <= top ||
+                minSize <= 0 || (Double.isNaN(scale) || Double.isInfinite(scale)) || scale <= 0 || scale > 10) return null;
+        long x1 = Long.MAX_VALUE, y1 = Long.MAX_VALUE, x2 = Long.MIN_VALUE, y2 = Long.MIN_VALUE;
+        for (int[] r : group) {
+            if (r == null || r.length != 4 || r[2] <= 0 || r[3] <= 0) return null;
+            x1 = Math.min(x1, r[0]); y1 = Math.min(y1, r[1]);
+            x2 = Math.max(x2, (long)r[0] + r[2]); y2 = Math.max(y2, (long)r[1] + r[3]);
+        }
+        double centerX = (x1 + x2) / 2.0, centerY = (y1 + y2) / 2.0;
+        int[][] out = new int[4][4];
+        for (int i = 0; i < 4; i++) {
+            int[] r = group[i];
+            long x = Math.round(centerX + (r[0] - centerX) * scale);
+            long y = Math.round(centerY + (r[1] - centerY) * scale);
+            long xEnd = Math.round(centerX + ((long)r[0] + r[2] - centerX) * scale);
+            long yEnd = Math.round(centerY + ((long)r[1] + r[3] - centerY) * scale);
+            long w = xEnd - x, h = yEnd - y;
+            if (w < minSize || h < minSize || x < left || y < top || x + w > right || y + h > bottom ||
+                    x < Integer.MIN_VALUE || y < Integer.MIN_VALUE || w > Integer.MAX_VALUE || h > Integer.MAX_VALUE) return null;
+            out[i] = new int[]{(int)x, (int)y, (int)w, (int)h};
+        }
+        for (int i = 0; i < 4; i++) {
+            for (int j = i + 1; j < 4; j++) if (overlaps(out[i], out[j])) return null;
+            for (int[] o : obstacles) {
+                if (o == null || o.length != 4 || o[2] <= 0 || o[3] <= 0 || overlaps(out[i], o)) return null;
+            }
+        }
+        return out;
+    }
+    private static boolean overlaps(int[] a, int[] b) {
+        return (long)a[0] < (long)b[0] + b[2] && (long)a[0] + a[2] > b[0] &&
+                (long)a[1] < (long)b[1] + b[3] && (long)a[1] + a[3] > b[1];
+    }
+}
