+package com.limelight.binding.input.virtual_controller;
+
+/** Maps displacement from a floating touch origin to a clamped controller axis. */
+public final class FloatingStickMath {
+    private FloatingStickMath() { }
+    public static float[] axes(float dx, float dy, float radius) {
+        if (!(radius > 0)) return new float[]{0, 0};
+        double length = Math.hypot(dx, dy);
+        double dead = radius * 0.12;
+        if (length <= dead) return new float[]{0, 0};
+        double magnitude = Math.min(1, (length - dead) / (radius - dead));
+        return new float[]{(float)(dx / length * magnitude), (float)(-dy / length * magnitude)};
+    }
+}
