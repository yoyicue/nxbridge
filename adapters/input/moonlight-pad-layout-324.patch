+                            event.getY() - floatingOriginY, floatingRadius);
+                    floatingX = floatingOriginX + xy[0] * floatingRadius;
+                    floatingY = floatingOriginY - xy[1] * floatingRadius;
+                    notifyOnMovement(xy[0], xy[1]);
+                }
+                break;
+            case MotionEvent.ACTION_CANCEL:
+            case MotionEvent.ACTION_UP:
+                if (isPressed()) {
