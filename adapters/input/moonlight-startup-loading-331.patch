diff --git a/app/src/main/java/com/limelight/binding/video/StartupFrameDetector.java b/app/src/main/java/com/limelight/binding/video/StartupFrameDetector.java
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/limelight/binding/video/StartupFrameDetector.java
@@ -0,0 +1,15 @@
+package com.limelight.binding.video;
+
+/** Only used during startup; intentionally black scenes are revealed after a bounded wait. */
+public final class StartupFrameDetector {
+    private StartupFrameDetector() {}
+    public static boolean hasVisibleContent(int[] pixels) {
+        if (pixels == null || pixels.length == 0) return false;
+        int bright = 0;
+        for (int pixel : pixels) {
+            int sum = ((pixel >> 16) & 255) + ((pixel >> 8) & 255) + (pixel & 255);
+            if (sum > 45) bright++;
+        }
+        return bright * 100 >= pixels.length;
+    }
+}
