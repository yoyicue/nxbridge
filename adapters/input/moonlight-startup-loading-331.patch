+    private void nxbFinishLoading() {
+        if (isFinishing() || displayedFailureDialog || nxbLoading.getVisibility() != View.VISIBLE) return;
+        nxbLoading.setVisibility(View.GONE);
+        if (virtualController != null && !isHidingOverlays) virtualController.show();
+    }
+
+    private void nxbWaitForVisibleFrame() {
+        if (isFinishing() || displayedFailureDialog || nxbWaitingForVisibleFrame ||
+                nxbLoading.getVisibility() != View.VISIBLE) return;
+        nxbWaitingForVisibleFrame = true;
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) {
+            nxbFinishLoading();
+            return;
+        }
+        nxbVisibleFrameDeadline = android.os.SystemClock.uptimeMillis() + 8000;
+        // Black can be intentional; never hide the game indefinitely.
+        nxbLoadingHandler.postDelayed(this::nxbFinishLoading, 8000);
+        nxbSampleVisibleFrame();
+    }
+
+    private void nxbSampleVisibleFrame() {
+        if (isFinishing() || displayedFailureDialog || nxbLoading.getVisibility() != View.VISIBLE) return;
+        if (android.os.SystemClock.uptimeMillis() >= nxbVisibleFrameDeadline) {
+            nxbFinishLoading();
+            return;
+        }
+        if (!streamView.getHolder().getSurface().isValid()) {
+            nxbLoadingHandler.postDelayed(this::nxbSampleVisibleFrame, 250);
+            return;
+        }
+        android.graphics.Bitmap probe = android.graphics.Bitmap.createBitmap(32, 18, android.graphics.Bitmap.Config.ARGB_8888);
+        try {
+            android.view.PixelCopy.request(streamView, probe, result -> {
+                boolean visible = false;
+                if (result == android.view.PixelCopy.SUCCESS) {
+                    int[] pixels = new int[32 * 18];
+                    probe.getPixels(pixels, 0, 32, 0, 0, 32, 18);
+                    visible = com.limelight.binding.video.StartupFrameDetector.hasVisibleContent(pixels);
+                }
+                probe.recycle();
+                if (visible) nxbFinishLoading();
+                else if (!isFinishing() && !displayedFailureDialog && nxbLoading.getVisibility() == View.VISIBLE)
+                    nxbLoadingHandler.postDelayed(this::nxbSampleVisibleFrame, 250);
+            }, nxbLoadingHandler);
+        } catch (IllegalArgumentException | IllegalStateException e) {
+            probe.recycle();
+            nxbLoadingHandler.postDelayed(this::nxbSampleVisibleFrame, 250);
+        }
+    }
+
