+package com.limelight.binding.input.virtual_controller;
+
+import android.util.JsonReader;
+import android.util.JsonToken;
+import org.json.JSONException;
+import org.json.JSONObject;
+import java.io.IOException;
+import java.io.StringReader;
+import java.util.HashSet;
+import java.util.Set;
+
+/** Strict, bounded syntax pass before Android JSONObject's permissive parser. */
+public final class StrictLayoutJson {
+    private static final int MAX_DEPTH = 16;
+    private static final int MAX_VALUES = 4096;
+    private StrictLayoutJson() { }
+
+    public static JSONObject parse(byte[] bytes) throws IOException, JSONException {
+        String text = PortableLayoutFile.decode(bytes);
+        try (JsonReader reader = new JsonReader(new StringReader(text))) {
+            reader.setLenient(false);
+            if (reader.peek() != JsonToken.BEGIN_OBJECT) throw new IOException("layout must be an object");
+            scan(reader, 0, new int[]{0});
+            if (reader.peek() != JsonToken.END_DOCUMENT) throw new IOException("trailing layout data");
+        } catch (IllegalStateException e) { throw new IOException("invalid layout JSON", e); }
+        return new JSONObject(text);
+    }
+
+    private static void scan(JsonReader reader, int depth, int[] count) throws IOException {
+        if (depth > MAX_DEPTH || ++count[0] > MAX_VALUES) throw new IOException("layout JSON too complex");
+        switch (reader.peek()) {
+            case BEGIN_OBJECT:
+                reader.beginObject();
+                Set<String> names = new HashSet<>();
+                while (reader.hasNext()) {
+                    String name = reader.nextName();
+                    if (!names.add(name)) throw new IOException("duplicate layout field");
+                    scan(reader, depth + 1, count);
+                }
+                reader.endObject(); break;
+            case BEGIN_ARRAY:
+                reader.beginArray();
+                while (reader.hasNext()) scan(reader, depth + 1, count);
+                reader.endArray(); break;
+            case STRING: case NUMBER: reader.nextString(); break;
+            case BOOLEAN: reader.nextBoolean(); break;
+            case NULL: reader.nextNull(); break;
+            default: throw new IOException("unexpected layout JSON token");
+        }
+    }
+
+    public static boolean isInteger(Object value) {
+        return value instanceof Integer || value instanceof Long;
+    }
+    public static boolean isNumber(Object value) { return value instanceof Number; }
+}
