+    /** Only files created for this exact profile are exposed, never arbitrary paths. */
+    public static String[] backupNames(File source) throws IOException {
+        File parent = source.getCanonicalFile().getParentFile();
+        String prefix = source.getName() + ".invalid-";
+        File[] files = parent.listFiles((dir, name) -> name.startsWith(prefix) && name.endsWith(".backup"));
+        if (files == null) throw new IOException("backup directory unavailable");
+        java.util.ArrayList<File> accepted = new java.util.ArrayList<>();
+        for (File candidate : files) {
+            if (candidate.isFile() && parent.equals(candidate.getCanonicalFile().getParentFile()) &&
+                    candidate.getCanonicalFile().equals(candidate.getAbsoluteFile())) accepted.add(candidate);
+        }
+        accepted.sort((a,b) -> { int time = Long.compare(b.lastModified(), a.lastModified()); return time != 0 ? time : a.getName().compareTo(b.getName()); });
+        String[] names = new String[accepted.size()];
+        for (int i = 0; i < names.length; i++) names[i] = accepted.get(i).getName();
+        return names;
+    }
+    private static File backupFor(File source, String name) throws IOException {
+        if (name == null || !name.startsWith(source.getName() + ".invalid-") || !name.endsWith(".backup") ||
+                !name.equals(new File(name).getName())) throw new IOException("invalid backup name");
+        File parent = source.getCanonicalFile().getParentFile();
+        File candidate = new File(parent, name);
+        if (!candidate.isFile() || !parent.equals(candidate.getCanonicalFile().getParentFile()) ||
+                !candidate.getCanonicalFile().equals(candidate.getAbsoluteFile())) throw new IOException("backup unavailable");
+        return candidate;
+    }
+    public static byte[] backupFingerprint(File source, String name) throws IOException {
+        return fingerprint(backupFor(source, name));
+    }
+    public static byte[] readBackupIfUnchanged(File source, String name, byte[] expected) throws IOException {
+        if (expected == null || expected.length != 32) throw new IOException("missing backup fingerprint");
+        MessageDigest hash = digest(); long total = 0;
+        ByteArrayOutputStream result = new ByteArrayOutputStream();
+        try (FileInputStream in = new FileInputStream(backupFor(source, name))) {
+            byte[] block = new byte[8192]; int n;
+            while ((n = in.read(block)) != -1) {
+                total += n; if (total > MAX_RECOVERY_BYTES) throw new IOException("invalid layout too large to export");
+                hash.update(block, 0, n); result.write(block, 0, n);
+            }
+        }
+        if (!MessageDigest.isEqual(expected, hash.digest())) throw new Changed();
+        return result.toByteArray();
+    }
     public static byte[] fingerprint(File source) throws IOException { return copy(source, null); }
     public static File backupIfUnchanged(File source, byte[] expected) throws IOException {
