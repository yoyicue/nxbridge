+        }
+        LayoutSafeArea safe = safeArea(); int gear = (int)(layoutHeight() * 0.06f);
+        obstacles.add(new int[]{safe.left + 15, safe.top + 15, gear, gear});
+        int[] delta = FaceGroupMovement.clamp(group, obstacles.toArray(new int[0][]),
+                safe.left, safe.top, safe.right, safe.bottom, dx, dy);
