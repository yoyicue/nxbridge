+package com.limelight.binding.input.virtual_controller;
+
+/** Move a set of hit rectangles as one, preserving all relative offsets. */
+public final class FaceGroupMovement {
+    private FaceGroupMovement() { }
+
+    public static int[] clamp(int[][] group, int[][] obstacles, int left, int top, int right, int bottom, int dx, int dy) {
+        if (group == null || group.length != 4 || obstacles == null || right <= left || bottom <= top) return new int[]{0, 0};
+        long minX = Long.MIN_VALUE, maxX = Long.MAX_VALUE, minY = Long.MIN_VALUE, maxY = Long.MAX_VALUE;
+        for (int[] r : group) {
+            if (r == null || r.length != 4 || r[2] <= 0 || r[3] <= 0) return new int[]{0, 0};
+            minX = Math.max(minX, (long)left - r[0]); maxX = Math.min(maxX, (long)right - r[0] - r[2]);
+            minY = Math.max(minY, (long)top - r[1]); maxY = Math.min(maxY, (long)bottom - r[1] - r[3]);
+        }
+        if (minX > maxX || minY > maxY) return new int[]{0, 0};
+        long x = Math.max(minX, Math.min((long)dx, maxX));
+        long y = Math.max(minY, Math.min((long)dy, maxY));
+        if (x < Integer.MIN_VALUE || x > Integer.MAX_VALUE || y < Integer.MIN_VALUE || y > Integer.MAX_VALUE) return new int[]{0, 0};
+        for (int[] g : group) for (int[] o : obstacles) {
+            if (o == null || o.length != 4 || o[2] <= 0 || o[3] <= 0) return new int[]{0, 0};
+            long gx = (long)g[0] + x, gy = (long)g[1] + y;
+            if (gx < (long)o[0] + o[2] && gx + g[2] > o[0] && gy < (long)o[1] + o[3] && gy + g[3] > o[1]) return new int[]{0, 0};
+        }
+        return new int[]{(int)x, (int)y};
+    }
+}
