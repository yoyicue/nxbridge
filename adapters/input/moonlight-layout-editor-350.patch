@@ -0,0 +1,22 @@
+package com.limelight.binding.input.virtual_controller;
+
+/** Names a device-local layout without depending on a mutable display title. */
+public final class LayoutIdentity {
+    private LayoutIdentity() { }
+    public static String key(String libraryId, String serverUuid, int appId, int orientation, boolean floating) {
+        return key(libraryId, serverUuid, appId, orientation, floating, false, false);
+    }
+    public static String key(String libraryId, String serverUuid, int appId, int orientation, boolean floating, boolean onlyStickClicks, boolean guideButton) {
+        String id;
+        if (libraryId != null && libraryId.matches("[A-Za-z0-9_.-]{1,64}")) {
+            id = "game:" + libraryId;
+        } else if (serverUuid != null && serverUuid.matches("[A-Za-z0-9-]{1,64}") && appId != 0) {
+            id = "legacy:" + serverUuid + ":" + appId;
+        } else {
+            throw new IllegalArgumentException("missing layout identity");
+        }
+        if (orientation != 1 && orientation != 2) throw new IllegalArgumentException("unknown orientation");
+        return id + ":" + orientation + ":" + (floating ? "floating" : "fixed") +
+                (onlyStickClicks ? ":stick-clicks-only" : "") + (guideButton ? ":guide" : "");
+    }
+}
diff --git a/app/src/main/java/com/limelight/binding/input/virtual_controller/LayoutProfileStore.java b/app/src/main/java/com/limelight/binding/input/virtual_controller/LayoutProfileStore.java
