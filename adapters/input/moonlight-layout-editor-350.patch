index 0000000..78e88a4
--- /dev/null
+++ b/app/src/main/java/com/limelight/LayoutEditorActivity.java
@@ -0,0 +1,42 @@
+package com.limelight;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.View;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+import com.limelight.binding.input.virtual_controller.VirtualController;
+
+/** Local, disconnected editor: it cannot send controller input to a game. */
+public final class LayoutEditorActivity extends Activity {
+    private VirtualController controller;
+    @Override protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        requestWindowFeature(Window.FEATURE_NO_TITLE);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
+        FrameLayout root = new FrameLayout(this);
+        root.setBackgroundColor(0xff19251f);
+        TextView label = new TextView(this);
+        label.setText(R.string.nxb_layout_preview); label.setTextColor(0xff9cb0a0); label.setGravity(Gravity.CENTER);
+        root.addView(label, new FrameLayout.LayoutParams(-1, -1));
+        setContentView(root);
+        root.post(() -> {
+            if (isFinishing()) return;
+            controller = new VirtualController(null, root, this);
+            controller.setLayoutIdentity(getIntent().getStringExtra(Game.EXTRA_LIBRARY_GAME_ID),
+                    getIntent().getStringExtra(Game.EXTRA_PC_UUID),
+                    getIntent().getIntExtra(Game.EXTRA_APP_ID, 0),
+                    getIntent().getStringExtra(Game.EXTRA_APP_NAME));
+            controller.refreshLayout();
+            controller.show();
+            controller.beginEditing(this::finish);
+        });
+    }
+    @Override public void onBackPressed() {
+        if (controller != null && controller.isEditing()) controller.cancelEditing();
+        else super.onBackPressed();
+    }
+}
