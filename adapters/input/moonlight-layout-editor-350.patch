+    }
+    private void writeAtomic(AtomicFile target, byte[] data) throws IOException {
+        FileOutputStream out = null;
+        try { out = target.startWrite(); out.write(data); out.getFD().sync(); target.finishWrite(out); }
+        catch (IOException | RuntimeException e) { if (out != null) target.failWrite(out); throw new IOException("layout write failed", e); }
+    }
+
+    long save(JSONObject draft, long expected, List<VirtualControllerElement> elements) throws IOException, JSONException {
+        synchronized (LOCK) {
+            JSONObject old = readDocument(file);
+            long current = old == null ? 0 : old.getLong("revision");
+            if (old != null) validate(old, elements);
+            if (current != expected || current == Long.MAX_VALUE) throw new RevisionConflict();
+            draft.put("revision", current + 1); validate(draft, elements);
+            byte[] data = draft.toString().getBytes(StandardCharsets.UTF_8); if (data.length > MAX_BYTES) throw new IOException("layout too large");
+            // History is immutable: a failed save cannot overwrite an earlier revision.
+            if (old != null) {
+                AtomicFile history = history(current);
+                JSONObject existing = readDocument(history);
+                if (existing == null) {
+                    File base = file.getBaseFile();
+                    String prefix = base.getName() + ".revision-";
+                    String[] entries = base.getParentFile().list((dir, name) -> name.startsWith(prefix) && !name.endsWith(".bak") && !name.endsWith(".new"));
+                    if (entries == null || entries.length >= 128) throw new IOException("layout history is full");
+                    writeAtomic(history, old.toString().getBytes(StandardCharsets.UTF_8));
+                } else if (!existing.toString().equals(old.toString())) {
+                    throw new IOException("layout history conflict");
+                }
+            }
+            writeAtomic(file, data);
+            return current + 1;
+        }
+    }
