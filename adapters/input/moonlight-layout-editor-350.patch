@@ -0,0 +1,37 @@
+package com.limelight.binding.input;
+
+/** Chooses one primary source for controller slot zero. A displaced physical
+ * controller must return to neutral before it can claim control again. */
+public final class SourceArbiter {
+    public enum Source { TOUCH, PHYSICAL }
+    private Source owner = Source.TOUCH;
+    private boolean physicalBlocked;
+    private long generation;
+
+    public Source owner() { return owner; }
+    public long generation() { return generation; }
+    public boolean claimTouch(boolean physicalNeutral) {
+        if (owner == Source.TOUCH) return false;
+        owner = Source.TOUCH;
+        physicalBlocked = !physicalNeutral;
+        generation++;
+        return true;
+    }
+    public boolean physicalUpdate(boolean meaningful, boolean physicalNeutral) {
+        if (physicalBlocked) {
+            if (physicalNeutral) physicalBlocked = false;
+            return false;
+        }
+        if (owner == Source.TOUCH && meaningful) {
+            owner = Source.PHYSICAL;
+            generation++;
+            return true;
+        }
+        return false;
+    }
+    public void reset(boolean physicalNeutral) {
+        owner = Source.TOUCH;
+        physicalBlocked = !physicalNeutral;
+        generation++;
+    }
+}
