--- /dev/null
+++ b/app/src/main/java/com/limelight/binding/input/virtual_controller/LayoutProfileStore.java
@@ -0,0 +1,206 @@
+package com.limelight.binding.input.virtual_controller;
+
+import android.content.Context;
+import android.util.AtomicFile;
+import android.widget.FrameLayout;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/** Private, versioned local profile; never deletes or modifies the old OSC preferences. */
+final class LayoutProfileStore {
+    private static final int MAX_BYTES = 64 * 1024;
+    private static final Object LOCK = new Object();
+    static final class RevisionConflict extends IOException {
+        RevisionConflict() { super("layout revision conflict"); }
+    }
+    private final String identity;
+    private final AtomicFile file;
+    private final int width, height, minTarget;
+
+    LayoutProfileStore(Context context, String identity, int width, int height) {
+        if (identity == null || identity.isEmpty() || width <= 0 || height <= 0) throw new IllegalArgumentException("invalid layout identity or display");
+        this.identity = identity;
+        this.width = width;
+        this.height = height;
+        this.minTarget = Math.max(1, (int)Math.ceil(48 * context.getResources().getDisplayMetrics().density));
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(identity.getBytes(StandardCharsets.UTF_8));
+            StringBuilder name = new StringBuilder();
+            for (byte b : digest) name.append(String.format(java.util.Locale.ROOT, "%02x", b & 255));
+            File dir = new File(context.getFilesDir(), "nxbridge-layouts");
+            if (!dir.isDirectory() && !dir.mkdirs() && !dir.isDirectory()) throw new IOException("layout directory unavailable");
+            file = new AtomicFile(new File(dir, name + ".json"));
+        } catch (Exception e) { throw new IllegalArgumentException("layout storage unavailable", e); }
+    }
+
+    private static String key(VirtualControllerElement element) {
+        return element.elementId + ((element instanceof AnalogStick && ((AnalogStick)element).isFloating()) ? "_float" : "");
+    }
+
+    /** A complete draft is captured on the UI thread; persistence runs away from input. */
+    JSONObject capture(List<VirtualControllerElement> elements, boolean hapticEnabled, boolean idleFade, boolean highContrast) throws JSONException, IOException {
+        if (elements.size() == 0 || elements.size() > 32) throw new IOException("invalid control count");
+        JSONArray controls = new JSONArray();
+        Set<String> seen = new HashSet<>();
+        for (VirtualControllerElement element : elements) {
+            String key = key(element);
+            if (!seen.add(key)) throw new IOException("duplicate control");
+            if (element.isOptionalControl() && !element.isControlEnabled()) continue;
+            FrameLayout.LayoutParams p = (FrameLayout.LayoutParams) element.getLayoutParams();
+            boolean zone = key.endsWith("_float");
+            if (p.leftMargin < 0 || p.topMargin < 0 || p.width <= 0 || p.height <= 0 ||
+                p.leftMargin + (long)p.width > width || p.topMargin + (long)p.height > height ||
+                (!zone && (p.width < minTarget || p.height < minTarget))) throw new IOException("control outside safe area or too small");
+            JSONObject item = new JSONObject();
+            item.put("id", key); item.put("x", p.leftMargin / (double)width); item.put("y", p.topMargin / (double)height);
+            item.put("w", p.width / (double)width); item.put("h", p.height / (double)height);
+            if (zone) {
+                float[] curve = ((AnalogStick)element).getCurve();
+                JSONObject c = new JSONObject(); c.put("d", curve[0]); c.put("s", curve[1]); c.put("e", curve[2]); c.put("gesture", ((AnalogStick)element).gestureEnabled());
+                item.put("curve", c);
+            }
+            controls.put(item);
+        }
+        JSONObject doc = new JSONObject(); doc.put("schema", 1); doc.put("identity", identity); doc.put("controls", controls); doc.put("revision", 1); doc.put("haptic", hapticEnabled); doc.put("fade", idleFade); doc.put("contrast", highContrast);
+        validate(doc, elements);
+        // Floating activation zones intentionally sit underneath buttons. Other
+        // targets must not overlap each other or the permanent settings entry.
+        for (int i = 0; i < controls.length(); i++) {
+            JSONObject a = controls.getJSONObject(i); if (a.getString("id").endsWith("_float")) continue;
+            double ax = a.getDouble("x") * width, ay = a.getDouble("y") * height;
+            double aw = a.getDouble("w") * width, ah = a.getDouble("h") * height;
+            double gear = height * 0.06;
+            if (ax < 15 + gear && ax + aw > 15 && ay < 15 + gear && ay + ah > 15) throw new IOException("control overlaps settings");
+            for (int j = i + 1; j < controls.length(); j++) {
+                JSONObject b = controls.getJSONObject(j); if (b.getString("id").endsWith("_float")) continue;
+                double bx = b.getDouble("x") * width, by = b.getDouble("y") * height;
+                double bw = b.getDouble("w") * width, bh = b.getDouble("h") * height;
+                if (ax < bx + bw - 0.01 && ax + aw > bx + 0.01 && ay < by + bh - 0.01 && ay + ah > by + 0.01) throw new IOException("overlapping controls");
+            }
+        }
+        return doc;
+    }
+
+    private JSONObject readDocument(AtomicFile target) throws IOException, JSONException {
+        if (!target.getBaseFile().exists() && !new File(target.getBaseFile().getPath() + ".bak").exists()) return null;
