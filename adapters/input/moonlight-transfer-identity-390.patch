 /** Names a device-local layout without depending on a mutable display title. */
 public final class LayoutIdentity {
     private LayoutIdentity() { }
+    /** Restored picker state must belong to the same layout, not merely the same revision. */
+    public static boolean sameTransferBase(String expectedIdentity, long expectedRevision, byte[] expectedFingerprint,
+                                           String currentIdentity, long currentRevision, byte[] currentFingerprint) {
+        return expectedIdentity != null && expectedIdentity.equals(currentIdentity) && expectedRevision == currentRevision &&
+                java.util.Arrays.equals(expectedFingerprint, currentFingerprint);
+    }
     public static String key(String libraryId, String serverUuid, int appId, int orientation, boolean floating) {
         return key(libraryId, serverUuid, appId, orientation, floating, false, false);
     }
