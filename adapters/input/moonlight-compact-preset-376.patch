+    /** Candidate for smaller reaches; preserves Switch face-button ordering and touch minimums. */
+    private void compactHandLayout() {
+        VirtualControllerElement top = null, left = null, lb = null, rb = null;
+        for (VirtualControllerElement e : elements) {
+            if (e.elementId == VirtualControllerElement.EID_Y) top = e;
+            else if (e.elementId == VirtualControllerElement.EID_X) left = e;
+            else if (e.elementId == VirtualControllerElement.EID_LB) lb = e;
+            else if (e.elementId == VirtualControllerElement.EID_RB) rb = e;
+        }
+        if (top != null && left != null) {
+            FrameLayout.LayoutParams tp = (FrameLayout.LayoutParams)top.getLayoutParams();
+            FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams)left.getLayoutParams();
+            int cx = tp.leftMargin + tp.width / 2, cy = lp.topMargin + lp.height / 2;
+            float density = context.getResources().getDisplayMetrics().density;
+            int size = Math.max((int)Math.ceil(48 * density), Math.round(Math.min(tp.width, tp.height) * 0.8f));
+            int step = size + (int)Math.ceil(4 * density);
+            for (VirtualControllerElement e : elements) {
+                int dx = 0, dy = 0;
+                if (e.elementId == VirtualControllerElement.EID_A) dy = step;
+                else if (e.elementId == VirtualControllerElement.EID_B) dx = step;
+                else if (e.elementId == VirtualControllerElement.EID_X) dx = -step;
+                else if (e.elementId == VirtualControllerElement.EID_Y) dy = -step;
+                else continue;
+                FrameLayout.LayoutParams p = (FrameLayout.LayoutParams)e.getLayoutParams();
+                p.width = size; p.height = size;
+                p.leftMargin = cx + dx - size / 2; p.topMargin = cy + dy - size / 2;
+                e.requestLayout();
+            }
+        }
+        for (VirtualControllerElement e : elements) {
+            VirtualControllerElement shoulder = e.elementId == VirtualControllerElement.EID_BACK ? lb :
+                    e.elementId == VirtualControllerElement.EID_START ? rb : null;
+            if (shoulder == null) continue;
+            FrameLayout.LayoutParams p = (FrameLayout.LayoutParams)e.getLayoutParams();
+            FrameLayout.LayoutParams sp = (FrameLayout.LayoutParams)shoulder.getLayoutParams();
+            p.leftMargin = sp.leftMargin + (sp.width - p.width) / 2;
+            e.requestLayout();
+        }
