index 00000000..777632a9
--- /dev/null
+++ b/app/src/main/java/com/limelight/binding/input/virtual_controller/LayoutCommitGuard.java
@@ -0,0 +1,19 @@
+package com.limelight.binding.input.virtual_controller;
+
+import java.io.IOException;
+
+/** Serializes only the final atomic commit with display/host invalidation. */
+public final class LayoutCommitGuard {
+    public static final class StaleDisplay extends IOException {
+        public StaleDisplay() { super("display changed before layout commit"); }
+    }
+    public interface Commit { void run() throws IOException; }
+    private long generation;
+
+    public synchronized long snapshot() { return generation; }
+    public synchronized void invalidate() { generation++; }
+    public synchronized void commit(long expected, Commit action) throws IOException {
+        if (expected != generation) throw new StaleDisplay();
+        action.run();
+    }
+}
