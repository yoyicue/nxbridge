+    private void handlePortableResult(int result, Intent data) {
+        int mode = pendingMode; byte[] draft = pendingDraft, fingerprint = pendingFingerprint; long revision = pendingRevision;
+        pendingMode = 0; pendingDraft = null; pendingFingerprint = null;
+        if (mode == 0 || draft == null || result != RESULT_OK || data == null || data.getData() == null) return;
+        Uri uri = data.getData();
+        if (!"content".equals(uri.getScheme())) { Toast.makeText(this, R.string.nxb_portable_failed, Toast.LENGTH_LONG).show(); return; }
+        new Thread(() -> {
+            byte[] imported = null; boolean success = false;
+            try {
+                if (mode == IMPORT) {
+                    try (InputStream input = getContentResolver().openInputStream(uri)) { imported = PortableLayoutFile.read(input); }
+                } else {
+                    try (OutputStream output = getContentResolver().openOutputStream(uri, "wt")) {
+                        if (output == null) throw new java.io.IOException("document unavailable");
+                        output.write(draft); output.flush();
+                    }
+                }
+                success = true;
+            } catch (Exception ignored) { }
+            final byte[] received = imported; final boolean finished = success;
+            runOnUiThread(() -> {
