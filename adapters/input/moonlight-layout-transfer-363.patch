+                if (!finished) { Toast.makeText(this, R.string.nxb_portable_failed, Toast.LENGTH_LONG).show(); return; }
+                if (mode == EXPORT) { Toast.makeText(this, R.string.nxb_portable_export_done, Toast.LENGTH_SHORT).show(); return; }
+                try {
+                    if (!controller.portableBaseMatches(revision, fingerprint) || !Arrays.equals(draft, controller.capturePortableDraft())) {
+                        Toast.makeText(this, R.string.nxb_portable_conflict, Toast.LENGTH_LONG).show(); return;
+                    }
+                    if (!controller.previewPortableDraft(received)) { Toast.makeText(this, R.string.nxb_portable_invalid, Toast.LENGTH_LONG).show(); return; }
+                } catch (Exception e) { Toast.makeText(this, R.string.nxb_portable_conflict, Toast.LENGTH_LONG).show(); }
+            });
+        }, "NXBridge layout transfer").start();
+    }
