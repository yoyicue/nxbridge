@@ -0,0 +1,53 @@
+package com.limelight.binding.input.virtual_controller;
+
+/** Coordinates local to the controller container, intersected with window insets. */
+public final class LayoutSafeArea {
+    public final int left, top, right, bottom;
+
+    private LayoutSafeArea(int left, int top, int right, int bottom) {
+        this.left = left; this.top = top; this.right = right; this.bottom = bottom;
+    }
+
+    public static LayoutSafeArea fromWindow(int width, int height, int rootWidth, int rootHeight,
+            int offsetX, int offsetY, int insetLeft, int insetTop, int insetRight, int insetBottom) {
+        if (width <= 0 || height <= 0 || rootWidth <= 0 || rootHeight <= 0 ||
+                insetLeft < 0 || insetTop < 0 || insetRight < 0 || insetBottom < 0)
+            throw new IllegalArgumentException("invalid window geometry");
+        long left = Math.max(0L, (long) insetLeft - offsetX);
+        long top = Math.max(0L, (long) insetTop - offsetY);
+        long right = Math.min((long) width, (long) rootWidth - insetRight - offsetX);
+        long bottom = Math.min((long) height, (long) rootHeight - insetBottom - offsetY);
+        if (left >= right || top >= bottom) throw new IllegalArgumentException("no safe area");
+        return new LayoutSafeArea((int) left, (int) top, (int) right, (int) bottom);
+    }
+
+    public boolean contains(int x, int y, int width, int height) {
+        return width > 0 && height > 0 && x >= left && y >= top &&
+                (long) x + width <= right && (long) y + height <= bottom;
+    }
+
+    /** Intersect with the parent-clipped visible part of the controller container. */
+    public LayoutSafeArea intersect(int clipLeft, int clipTop, int clipRight, int clipBottom) {
+        int l = Math.max(left, clipLeft), t = Math.max(top, clipTop);
+        int r = Math.min(right, clipRight), b = Math.min(bottom, clipBottom);
+        if (l >= r || t >= b) throw new IllegalArgumentException("no visible safe area");
+        return new LayoutSafeArea(l, t, r, b);
+    }
+
+    /** Preserve target size where possible; shrink only if the available area is smaller. */
+    public int[] constrain(int x, int y, int width, int height) {
+        if (width <= 0 || height <= 0) throw new IllegalArgumentException("invalid target");
+        int w = Math.min(width, right - left), h = Math.min(height, bottom - top);
+        int l = (int)Math.max(left, Math.min((long)x, (long)right - w));
+        int t = (int)Math.max(top, Math.min((long)y, (long)bottom - h));
+        return new int[]{l, t, w, h};
+    }
+
+    @Override public boolean equals(Object value) {
+        if (!(value instanceof LayoutSafeArea)) return false;
+        LayoutSafeArea other = (LayoutSafeArea)value;
+        return left == other.left && top == other.top && right == other.right && bottom == other.bottom;
+    }
+
+    @Override public int hashCode() { return (((left * 31) + top) * 31 + right) * 31 + bottom; }
+}
