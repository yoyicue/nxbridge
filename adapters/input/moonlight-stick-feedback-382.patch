@@ -0,0 +1,13 @@
+package com.limelight.binding.input.virtual_controller;
+
+/** At most one local feedback request per touch, when the stick reaches full output. */
+public final class StickEdgeFeedback {
+    private boolean fired;
+    public void reset() { fired = false; }
+    public boolean onMove(boolean enabled, float x, float y) {
+        if (fired || !enabled || Float.isNaN(x) || Float.isNaN(y) || Float.isInfinite(x) || Float.isInfinite(y)) return false;
+        if (Math.hypot(x, y) < 0.999) return false;
+        fired = true;
+        return true;
+    }
+}
