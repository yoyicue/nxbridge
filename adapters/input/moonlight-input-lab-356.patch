@@ -0,0 +1,30 @@
+package com.limelight.binding.input;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Bounded, in-memory diagnostic events; no wall-clock time or game content. */
+public final class InputLabTrace {
+    public static final class Entry {
+        public final long sequence, monotonicNanos;
+        public final String kind, detail;
+        Entry(long sequence, long monotonicNanos, String kind, String detail) {
+            this.sequence = sequence; this.monotonicNanos = monotonicNanos; this.kind = kind; this.detail = detail;
+        }
+    }
+    private final int capacity;
+    private final ArrayDeque<Entry> entries = new ArrayDeque<>();
+    private long nextSequence = 1;
+    public InputLabTrace(int capacity) {
+        if (capacity < 1 || capacity > 1024) throw new IllegalArgumentException("invalid trace capacity");
+        this.capacity = capacity;
+    }
+    public synchronized void record(long monotonicNanos, String kind, String detail) {
+        if (kind == null || detail == null || kind.length() > 40 || detail.length() > 512) throw new IllegalArgumentException("invalid trace event");
+        if (entries.size() == capacity) entries.removeFirst();
+        entries.addLast(new Entry(nextSequence++, monotonicNanos, kind, detail));
+    }
+    public synchronized List<Entry> snapshot() { return new ArrayList<>(entries); }
+    public synchronized void clear() { entries.clear(); }
+}
