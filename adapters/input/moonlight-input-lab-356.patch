+package com.limelight;
+
+import android.app.Activity;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.view.Gravity;
+import android.view.InputDevice;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.Button;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.limelight.binding.input.ControllerHandler;
+import com.limelight.binding.input.InputLabTrace;
+import com.limelight.binding.input.virtual_controller.VirtualController;
+import com.limelight.nvstream.NvConnection;
+import com.limelight.nvstream.input.ControllerPacket;
+import com.limelight.nvstream.jni.MoonBridge;
+import com.limelight.preferences.PreferenceConfiguration;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Offline diagnostic: real controller parsing and OSC views, with a non-network sink. */
+public final class InputLabActivity extends Activity {
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    private final InputLabTrace trace = new InputLabTrace(128);
+    private final Map<String, String> touches = new LinkedHashMap<>();
+    private ControllerHandler input;
+    private VirtualController controller;
+    private TextView status;
+    private String lastPacket = "", packetDisplay;
+    private boolean updatePending;
+    private volatile boolean closed;
+
+    @Override protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        packetDisplay = getString(R.string.nxb_input_lab_initial);
+        requestWindowFeature(Window.FEATURE_NO_TITLE);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
+        FrameLayout root = new FrameLayout(this);
+        root.setBackgroundColor(0xff19251f);
+        root.setFocusableInTouchMode(true);
+        setContentView(root);
+        root.post(() -> {
+            if (isFinishing() || isDestroyed()) return;
+            LabConnection sink = new LabConnection(this);
+            input = new ControllerHandler(this, sink, () -> { }, PreferenceConfiguration.readPreferences(this));
+            controller = new VirtualController(input, root, this);
+            controller.setLayoutIdentity(getIntent().getStringExtra(Game.EXTRA_LIBRARY_GAME_ID),
+                    getIntent().getStringExtra(Game.EXTRA_PC_UUID), getIntent().getIntExtra(Game.EXTRA_APP_ID, 0),
+                    getIntent().getStringExtra(Game.EXTRA_APP_NAME));
+            controller.setTouchObserver(this::onTouchOwners);
+            controller.refreshLayout(); controller.setConfigureEnabled(false); controller.show();
+            input.setNxbLabTakeover(controller::cancelForPhysicalTakeover);
+            addPanel(root);
+            root.requestFocus();
+            record("lab", "started");
+        });
+    }
+
+    private void addPanel(FrameLayout root) {
+        LinearLayout panel = new LinearLayout(this);
+        panel.setOrientation(LinearLayout.VERTICAL); panel.setPadding(20, 12, 20, 12); panel.setBackgroundColor(0xe91a3025);
+        TextView title = new TextView(this); title.setText(R.string.nxb_input_lab_title); title.setTextColor(0xffffffff); title.setTextSize(15); panel.addView(title);
+        status = new TextView(this); status.setTextColor(0xffe3f5e6); status.setTextSize(13); status.setMaxLines(8); panel.addView(status);
+        LinearLayout row = new LinearLayout(this); row.setGravity(Gravity.CENTER);
+        addButton(row, R.string.nxb_input_lab_clear, () -> {
+            trace.clear(); record("lab", "trace cleared");
+            String packet; synchronized (this) { packet = lastPacket; }
+            if (!packet.isEmpty()) record("input", packet);
+        });
+        addButton(row, R.string.nxb_input_lab_copy, this::copyTrace);
+        addButton(row, R.string.nxb_input_lab_close, this::finish);
+        panel.addView(row);
+        int width = Math.min((int)(getResources().getDisplayMetrics().widthPixels * 0.39f), (int)(540 * getResources().getDisplayMetrics().density));
+        FrameLayout.LayoutParams p = new FrameLayout.LayoutParams(width, FrameLayout.LayoutParams.WRAP_CONTENT, Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
+        p.bottomMargin = (int)(getResources().getDisplayMetrics().density * 40);
+        root.addView(panel, p); controller.setPriorityOverlay(panel);
+    }
+
+    private void addButton(LinearLayout row, int text, Runnable action) {
+        Button button = new Button(this); button.setText(text); button.setAllCaps(false); button.setOnClickListener(v -> action.run());
+        row.addView(button, new LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1));
+    }
+
+    private void record(String kind, String detail) {
+        if (closed) return;
+        trace.record(SystemClock.elapsedRealtimeNanos(), kind, detail.length() > 512 ? detail.substring(0, 512) : detail);
+        synchronized (this) {
+            if (updatePending) return;
+            updatePending = true;
+        }
+        ui.postDelayed(() -> { synchronized (InputLabActivity.this) { updatePending = false; } render(); }, 50);
+    }
+
+    private void onTouchOwners(String control, int[] ids, boolean blocked) {
+        if (ids.length == 0) touches.remove(control);
+        else touches.put(control, Arrays.toString(ids) + (blocked ? " (" + getString(R.string.nxb_input_lab_blocked) + ")" : ""));
+        record("touch", control + " " + Arrays.toString(ids) + (blocked ? " blocked" : ""));
+    }
+
+    private static String buttons(int flags, int lt, int rt) {
+        int[] masks = {ControllerPacket.A_FLAG, ControllerPacket.B_FLAG, ControllerPacket.X_FLAG, ControllerPacket.Y_FLAG,
+                ControllerPacket.LB_FLAG, ControllerPacket.RB_FLAG, ControllerPacket.UP_FLAG, ControllerPacket.DOWN_FLAG,
+                ControllerPacket.LEFT_FLAG, ControllerPacket.RIGHT_FLAG, ControllerPacket.BACK_FLAG, ControllerPacket.PLAY_FLAG,
+                ControllerPacket.LS_CLK_FLAG, ControllerPacket.RS_CLK_FLAG, ControllerPacket.SPECIAL_BUTTON_FLAG};
+        String[] names = {"A", "B", "X", "Y", "L", "R", "↑", "↓", "←", "→", "−", "+", "L3", "R3", "HOME"};
+        StringBuilder result = new StringBuilder();
+        for (int i = 0; i < masks.length; i++) if ((flags & masks[i]) != 0) { if (result.length() > 0) result.append(' '); result.append(names[i]); }
+        if (lt != 0) result.append(" ZL:").append(lt);
+        if (rt != 0) result.append(" ZR:").append(rt);
+        return result.length() == 0 ? "—" : result.toString().trim();
+    }
+
+    private void onPacket(short slot, int flags, byte lt, byte rt, short lx, short ly, short rx, short ry) {
+        String source = input == null ? "TOUCH:0" : input.nxbSourceDescription();
+        String packet = String.format(Locale.ROOT, "slot=%d source=%s buttons=%d triggers=%d,%d axes=%d,%d,%d,%d",
+                (int)slot, source, flags, lt & 255, rt & 255, (int)lx, (int)ly, (int)rx, (int)ry);
+        synchronized (this) {
+            if (packet.equals(lastPacket)) return;
+            lastPacket = packet;
+            String owner = getString(source.startsWith("PHYSICAL:") ? R.string.nxb_input_lab_physical : R.string.nxb_input_lab_touch);
+            packetDisplay = getString(R.string.nxb_input_lab_state, owner, (int)slot, buttons(flags, lt & 255, rt & 255), (int)lx, (int)ly, (int)rx, (int)ry);
+        }
+        record("input", packet);
+    }
+
+    private void render() {
+        if (closed || status == null) return;
+        String display; synchronized (this) { display = packetDisplay; }
+        StringBuilder output = new StringBuilder(display).append('\n').append(getString(R.string.nxb_input_lab_owners)).append(' ');
+        if (touches.isEmpty()) output.append("—");
+        else for (Map.Entry<String, String> entry : touches.entrySet()) output.append(entry.getKey()).append(':').append(entry.getValue()).append(' ');
+        List<InputLabTrace.Entry> recent = trace.snapshot();
+        for (int i = Math.max(0, recent.size() - 3); i < recent.size(); i++) {
+            InputLabTrace.Entry e = recent.get(i); output.append("\n#").append(e.sequence).append(' ').append(e.kind).append(' ').append(e.detail);
+        }
+        status.setText(output.toString());
+    }
+
+    private void copyTrace() {
+        StringBuilder output = new StringBuilder("NXBridge input lab v1 · monotonic nanoseconds · local events only\n");
+        for (InputLabTrace.Entry e : trace.snapshot()) output.append(e.sequence).append(' ').append(e.monotonicNanos).append(' ').append(e.kind).append(' ').append(e.detail).append('\n');
+        ClipboardManager clipboard = (ClipboardManager)getSystemService(Context.CLIPBOARD_SERVICE);
+        clipboard.setPrimaryClip(ClipData.newPlainText("NXBridge input trace", output.toString()));
+        Toast.makeText(this, R.string.nxb_input_lab_copied, Toast.LENGTH_SHORT).show();
+    }
+
+    @Override public boolean onKeyDown(int keyCode, KeyEvent event) {
+        if (input != null && ControllerHandler.isGameControllerDevice(event.getDevice()) && input.handleButtonDown(event)) return true;
+        return super.onKeyDown(keyCode, event);
+    }
+    @Override public boolean onKeyUp(int keyCode, KeyEvent event) {
+        if (input != null && ControllerHandler.isGameControllerDevice(event.getDevice()) && input.handleButtonUp(event)) return true;
+        return super.onKeyUp(keyCode, event);
+    }
+    @Override public boolean onGenericMotionEvent(MotionEvent event) {
+        if (input != null && (event.getSource() & InputDevice.SOURCE_JOYSTICK) == InputDevice.SOURCE_JOYSTICK && input.handleMotionEvent(event)) return true;
+        return super.onGenericMotionEvent(event);
+    }
+    @Override protected void onResume() { super.onResume(); if (input != null) input.setLayoutInputSuppressed(false); }
+    @Override protected void onPause() {
+        if (input != null) input.setLayoutInputSuppressed(true);
+        if (controller != null) controller.cancelForPhysicalTakeover();
+        super.onPause();
+    }
+    @Override protected void onDestroy() {
+        closed = true;
+        if (controller != null) controller.onHostDestroyed();
+        if (input != null) input.destroy();
+        ui.removeCallbacksAndMessages(null);
+        super.onDestroy();
+    }
+
+    /** Every ControllerHandler output is intercepted; no method calls the native network bridge. */
+    private final class LabConnection extends NvConnection {
+        LabConnection(Context context) { super(context.getApplicationContext(), null, 0, "local-lab", null, null, null); }
+        @Override public void sendControllerInput(short slot, short mask, int flags, byte lt, byte rt, short lx, short ly, short rx, short ry) { onPacket(slot, flags, lt, rt, lx, ly, rx, ry); }
+        @Override public int sendControllerArrivalEvent(byte slot, short mask, byte type, int flags, short caps) { record("device", "arrival slot=" + slot); return 0; }
+        @Override public int sendControllerTouchEvent(byte slot, byte type, int pointer, float x, float y, float pressure) { return MoonBridge.LI_ERR_UNSUPPORTED; }
+        @Override public int sendControllerMotionEvent(byte slot, byte type, float x, float y, float z) { return MoonBridge.LI_ERR_UNSUPPORTED; }
+        @Override public void sendControllerBatteryEvent(byte slot, byte state, byte percent) { }
+        @Override public void sendMouseButtonDown(byte button) { }
+        @Override public void sendMouseButtonUp(byte button) { }
+        @Override public void sendMouseScroll(byte clicks) { }
+        @Override public void sendMouseHScroll(byte clicks) { }
+        @Override public void sendMouseMove(short x, short y) { }
+        @Override public void sendMouseHighResScroll(short clicks) { }
+        @Override public void sendMouseHighResHScroll(short clicks) { }
+    }
+}
