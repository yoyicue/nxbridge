+package com.limelight.binding.input.virtual_controller;
+
+import java.util.TreeSet;
+
+/** Tracks only fingers that began within this button. */
+final class ButtonTouchOwners {
+    private final TreeSet<Integer> ids = new TreeSet<>();
+    boolean down(int id, boolean inside) {
+        boolean wasEmpty = ids.isEmpty();
+        if (inside) ids.add(id);
+        return inside && wasEmpty && !ids.isEmpty();
+    }
+    boolean up(int id) { return ids.remove(id) && ids.isEmpty(); }
+    boolean cancel() { boolean held = !ids.isEmpty(); ids.clear(); return held; }
+    int[] ids() { int[] result = new int[ids.size()]; int i = 0; for (int id : ids) result[i++] = id; return result; }
+}
